# Brain service: REST + MCP (Streamable HTTP) + knowledge ingestion, CPU only.
FROM python:3.12-slim

WORKDIR /app
# Dependencies first so source edits do not re-download torch.
RUN python -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir "sentence-transformers>=3,<6" "PyYAML>=6" "sqlite-vec>=0.1.6,<0.2" \
       "fastapi>=0.115,<1" "uvicorn[standard]>=0.30,<1" "psycopg[binary]>=3.2,<4" "psycopg-pool>=3.2,<4"
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip install --no-cache-dir --no-deps .

# Mount a Hugging Face cache here; with BRAIN_ALLOW_MODEL_DOWNLOAD=true the model is fetched once.
# The port is BRAIN_PORT, else the host's PORT (Railway), else 8020.
ENV HF_HOME=/hf \
    BRAIN_HOST=0.0.0.0 \
    PYTHONUNBUFFERED=1
EXPOSE 8020
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=10 \
  CMD python -c "import os, urllib.request; port = os.environ.get('BRAIN_PORT') or os.environ.get('PORT') or '8020'; urllib.request.urlopen(f'http://127.0.0.1:{port}/healthz', timeout=4)"
CMD ["brain-server"]
